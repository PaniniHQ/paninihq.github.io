---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Base title="Blog | Panini" activeNav="blog">
  <p class="pn-section-label">Blog</p>
  <p class="pn-sub">Notes from our experiments, product updates, and releases.</p>

  {
    posts.length === 0 ? (
      <p class="pn-sub">Nothing here yet. Check back soon.</p>
    ) : (
      <ul class="pn-post-list">
        {posts.map((post) => (
          <li class="pn-post-item">
            <p class="pn-post-item-title">
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            </p>
            <p class="pn-post-item-meta">
              {post.data.pubDate.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </p>
            <p class="pn-post-item-desc">{post.data.description}</p>
          </li>
        ))}
      </ul>
    )
  }
</Base>

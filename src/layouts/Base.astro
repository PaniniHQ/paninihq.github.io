---
interface Props {
  title: string;
  description?: string;
  activeNav?: 'blog' | 'resources';
}

const {
  title,
  description = 'Panini is a Product Technology Lab from Bengaluru, India.',
  activeNav,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{title}</title>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=DM+Mono:wght@400;500&display=swap');
    </style>
  </head>
  <body>
    <div class="pn-root">
      <nav class="pn-nav" aria-label="Main">
        <div class="pn-nav-left">
          <a href="/" class="pn-wordmark-link"><p class="pn-wordmark">Panini</p></a>
          <div class="pn-nav-links">
            <a href="/blog" class:list={['pn-nav-link', { active: activeNav === 'blog' }]} aria-current={activeNav === 'blog' ? 'page' : undefined}>Blog</a>
            <a href="/resources" class:list={['pn-nav-link', { active: activeNav === 'resources' }]} aria-current={activeNav === 'resources' ? 'page' : undefined}>Resources</a>
          </div>
        </div>
      </nav>

      <main>
        <slot />
      </main>

      <footer>
      <section class="pn-section pn-subscribe" aria-labelledby="pn-subscribe-label">
        <h2 class="pn-section-label" id="pn-subscribe-label">Stay updated</h2>
        <p>
          Panini is early in its journey. Stay connected to know what we are
          building, read notes from our experiments and new releases.
          Unsubscribe any time.
        </p>
        <form
          class="pn-subscribe-form"
          action="https://buttondown.com/api/emails/embed-subscribe/paninihq"
          method="post"
        >
          <input
            type="email"
            name="email"
            aria-label="Email address"
            class="pn-subscribe-input"
            placeholder="Your email"
            required
          />
          <button type="submit" class="pn-subscribe-btn">Subscribe</button>
        </form>
        <p class="pn-subscribe-note">
          If you'd rather not share your email, you can use <a
            href="https://kill-the-newsletter.com"
            target="_blank"
            rel="noopener">kill the newsletter</a
          > to turn it into an RSS feed instead.
        </p>
      </section>

      <section class="pn-section">
      <p class="pn-contact">
        Reach us at <a href="mailto:hello@paninihq.com">hello@paninihq.com</a> to know how can we help you. Or just to say hi!
      </p>
      </section>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --color-bg: #ffffff;
    --color-text-primary: #141414;
    --color-text-secondary: #3d3d40;
    --color-text-tertiary: #5c5c60;
    --color-border-tertiary: #d6d6d8;
    --color-border-strong: #6e6e72;
    --color-surface: #f4f4f5;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --color-bg: #111112;
      --color-text-primary: #f3f3f4;
      --color-text-secondary: #cfcfd2;
      --color-text-tertiary: #a6a6aa;
      --color-border-tertiary: #3a3a3e;
      --color-border-strong: #8e8e93;
      --color-surface: #1c1c1e;
    }
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    background: var(--color-bg);
  }

  .pn-root {
    font-family: 'EB Garamond', Georgia, serif;
    color: var(--color-text-primary);
    max-width: 640px;
    margin: 0 auto;
    padding: 3rem 1.5rem 4rem;
    font-size: 18px;
    line-height: 1.7;
  }

  a:focus-visible,
  button:focus-visible,
  input:focus-visible {
    outline: 2px solid var(--color-text-primary);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .pn-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 0 1.25rem;
    margin: 0 0 3rem;
    border-bottom: 1px solid var(--color-border-tertiary);
  }

  .pn-nav-left {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .pn-wordmark-link {
    text-decoration: none;
  }

  .pn-wordmark {
    font-family: 'DM Mono', monospace;
    font-weight: 400;
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-primary);
    margin: 0;
  }

  .pn-nav-links {
    display: flex;
    gap: 1.5rem;
  }

  .pn-nav-link {
    font-family: 'DM Mono', monospace;
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.06em;
    color: var(--color-text-secondary);
    text-decoration: none;
    padding: 2px 0;
    border-bottom: 1px solid transparent;
  }

  .pn-nav-link:hover {
    color: var(--color-text-primary);
  }

  .pn-nav-link.disabled {
    opacity: 0.4;
    pointer-events: none;
    cursor: default;
  }

  .pn-nav-link.active {
    color: var(--color-text-primary);
    font-weight: 500;
    border-bottom-color: var(--color-text-primary);
  }

  .pn-info-btn {
    background: none;
    border: none;
    padding: 0;
    margin: 0 6px;
    cursor: pointer;
    color: var(--color-text-secondary);
    display: inline-flex;
    align-items: center;
    vertical-align: middle;
  }

  .pn-info-btn:hover {
    color: var(--color-text-primary);
  }

  .pn-info-popover {
    font-family: 'EB Garamond', Georgia, serif;
    font-size: 17px;
    line-height: 1.6;
    color: var(--color-text-secondary);
    background: var(--color-bg);
    border: 1px solid var(--color-border-tertiary);
    border-radius: 8px;
    padding: 1.25rem 1.5rem;
    max-width: 360px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }

  .pn-info-popover p {
    margin: 0 0 0.75rem;
  }

  .pn-info-popover p:last-child {
    margin-bottom: 0;
  }

  .pn-info-popover a {
    color: var(--color-text-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .pn-info-btn svg {
    width: 16px;
    height: 16px;
  }

  .pn-heading {
    font-size: 27px;
    font-weight: 500;
    line-height: 1.35;
    margin: 0 0 1rem;
  }

  .pn-sub {
    font-size: 19px;
    color: var(--color-text-secondary);
    margin: 0 0 1.5rem;
    line-height: 1.65;
  }

  .pn-hero {
    padding: 0 0 1.5rem;
  }

  .pn-sub:last-child {
    margin-bottom: 0;
  }

  .pn-divider {
    border: none;
    border-top: 1px solid var(--color-border-tertiary);
    margin: 2.5rem 0;
  }

  /* Distinct page sections, each with a rule and generous breathing room */
  .pn-section {
    border-top: 1px solid var(--color-border-tertiary);
    padding: 2.75rem 0;
  }

  /* Section with a shaded band that bleeds to the full viewport width,
     while its content stays aligned with the text column */
  .pn-section.pn-card {
    border-top: none;
    background: var(--color-surface);
    box-shadow: 0 0 0 100vmax var(--color-surface);
    clip-path: inset(0 -100vmax);
    padding: 2.75rem 0;
    margin: 1rem 0 2rem;
  }

  .pn-card + .pn-section {
    border-top: none;
    padding-top: 1rem;
  }

  footer .pn-section:last-child {
    padding-bottom: 0;
  }

  .pn-section-label {
    font-family: 'DM Mono', monospace;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin: 0 0 1.5rem;
    line-height: 1.4;
  }

  .pn-people {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin: 0;
  }

  .pn-person {
    display: flex;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
    border: 1px solid var(--color-border-tertiary);
    border-radius: 4px;
    padding: 1.25rem 1.5rem;
    transition: border-color 0.15s ease;
  }

  .pn-person:hover {
    border-color: var(--color-border-strong);
  }

  .pn-person:hover .pn-person-link {
    color: var(--color-text-primary);
    text-decoration-color: currentColor;
  }

  .pn-person .pn-person-link {
    margin-top: auto;
    align-self: flex-start;
  }

  .pn-person-name {
    font-size: 19px;
    font-weight: 500;
    margin: 0 0 2px;
  }

  .pn-person-desc {
    font-size: 17px;
    color: var(--color-text-secondary);
    margin: 0 0 8px;
    line-height: 1.5;
  }

  .pn-person-link {
    font-family: 'DM Mono', monospace;
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.06em;
    color: var(--color-text-secondary);
    text-decoration: underline;
    text-decoration-color: var(--color-border-tertiary);
    text-underline-offset: 4px;
  }

  .pn-person-link:hover {
    color: var(--color-text-primary);
    text-decoration-color: currentColor;
  }

  .pn-contact {
    font-size: 18px;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .pn-contact a {
    color: var(--color-text-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .pn-subscribe > p:not([class]) {
    color: var(--color-text-secondary);
    margin: 0 0 1.25rem;
  }

  .pn-subscribe-form {
    display: flex;
    gap: 0.5rem;
    max-width: 400px;
  }

  .pn-subscribe-input {
    font-family: 'EB Garamond', Georgia, serif;
    font-size: 17px;
    padding: 0.55rem 0.8rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 4px;
    background: transparent;
    color: var(--color-text-primary);
    flex: 1;
    outline: none;
  }

  .pn-subscribe-input::placeholder {
    color: var(--color-text-tertiary);
  }

  .pn-subscribe-input:focus {
    border-color: var(--color-text-primary);
  }

  .pn-subscribe-btn {
    font-family: 'DM Mono', monospace;
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-text-primary);
    border-radius: 4px;
    background: var(--color-text-primary);
    color: var(--color-bg);
    cursor: pointer;
    white-space: nowrap;
  }

  .pn-subscribe-btn:hover {
    background: var(--color-text-secondary);
    border-color: var(--color-text-secondary);
  }

  .pn-subscribe-note {
    font-size: 15px;
    color: var(--color-text-tertiary);
    margin: 0.75rem 0 0;
  }

  .pn-subscribe-note a {
    color: var(--color-text-secondary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Blog listing */
  .pn-post-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
  }

  .pn-post-item {
    margin: 0 0 2rem;
  }

  .pn-post-item:last-child {
    margin-bottom: 0;
  }

  .pn-post-item-title {
    font-size: 21px;
    font-weight: 500;
    margin: 0 0 4px;
  }

  .pn-post-item-title a {
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .pn-post-item-title a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .pn-post-item-meta {
    font-family: 'DM Mono', monospace;
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.06em;
    color: var(--color-text-tertiary);
    margin: 0 0 4px;
  }

  .pn-post-item-desc {
    font-size: 17px;
    color: var(--color-text-secondary);
    margin: 0;
    line-height: 1.5;
  }

  /* Post page */
  .pn-post-header {
    margin: 0 0 2.5rem;
  }

  .pn-post-title {
    font-size: 30px;
    font-weight: 500;
    line-height: 1.35;
    margin: 0 0 0.75rem;
  }

  .pn-post-meta {
    font-family: 'DM Mono', monospace;
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.06em;
    color: var(--color-text-tertiary);
    margin: 0;
  }

  .pn-prose {
    font-size: 19px;
    margin: 0 0 3rem;
  }

  .pn-prose p {
    margin: 0 0 1.5rem;
  }

  .pn-prose h2 {
    font-size: 23px;
    font-weight: 500;
    margin: 2.5rem 0 1rem;
  }

  .pn-prose h3 {
    font-size: 20px;
    font-weight: 500;
    margin: 2rem 0 1rem;
  }

  .pn-prose a {
    color: var(--color-text-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .pn-prose ul,
  .pn-prose ol {
    margin: 0 0 1.5rem;
    padding-left: 1.5rem;
  }

  .pn-prose li {
    margin: 0 0 0.5rem;
  }

  .pn-prose hr {
    border: none;
    border-top: 1px solid var(--color-border-tertiary);
    margin: 2.5rem 0;
  }

  .pn-prose blockquote {
    margin: 0 0 1.5rem;
    padding-left: 1rem;
    border-left: 3px solid var(--color-border-strong);
    color: var(--color-text-secondary);
  }

  .pn-prose code {
    font-family: 'DM Mono', monospace;
    font-size: 0.85em;
    background: var(--color-surface);
    padding: 0.1em 0.35em;
    border-radius: 3px;
  }

  .pn-prose pre {
    font-family: 'DM Mono', monospace;
    font-size: 13px;
    overflow-x: auto;
    padding: 1rem;
    border-radius: 6px;
    margin: 0 0 1.5rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border-tertiary);
  }

  .pn-prose pre code {
    background: none;
    padding: 0;
  }

  .pn-prose figure {
    margin: 2rem 0;
  }

  .pn-prose figure img,
  .pn-prose figure svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .pn-prose figcaption {
    margin-top: 0.6rem;
    font-family: 'DM Mono', monospace;
    font-size: 13px;
    letter-spacing: 0.03em;
    color: var(--color-text-tertiary);
    text-align: center;
  }

  .pn-back-link {
    display: inline-block;
    font-family: 'DM Mono', monospace;
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.06em;
    color: var(--color-text-secondary);
    text-decoration: none;
    margin: 0 0 2.5rem;
  }

  .pn-back-link:hover {
    color: var(--color-text-primary);
  }

  @media (max-width: 480px) {
    .pn-nav {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }

    .pn-nav-left {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }

    .pn-people {
      grid-template-columns: 1fr;
    }

    .pn-subscribe-form {
      flex-direction: column;
    }
  }
</style>
